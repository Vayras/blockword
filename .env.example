# --- server (apps/server) ---
PORT=8787
# The only mint stakes are accepted from. The default is a TEST mint (fake sats).
MINT_URL=https://testnut.cashu.space
# Where the escrow's ecash and the jackpot are stored. Back this up: it IS the money.
DATA_DIR=./apps/server/data
# Share of the jackpot a winning team can take (capped at the room's pot).
JACKPOT_SHARE=0.2
# Comma-separated origins allowed to open the WebSocket (empty = any).
ALLOWED_ORIGINS=

# --- web (apps/web), only if the web app is hosted separately from the server ---
# VITE_SERVER_URL=https://blockword.example.com
# VITE_MINT_URL=https://testnut.cashu.space
